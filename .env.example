# ==============================================================================
# BMQOS Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Authentication & Session
# ------------------------------------------------------------------------------
# Authentication mode: empty = NO login (default, fine on your own machine or a private network),
# "password" = password login (needs OS_PASSWORD_HASH + OS_SESSION_SECRET), "none" = force no login.
# Setting OS_PASSWORD_HASH alone also turns the password login on.
OS_AUTH=

# Optional code required by the first-run setup wizard (set it on a public instance)
OS_SETUP_TOKEN=

# Single admin username for signing in
OS_USER=admin

# Password hash generated via: npm run hash -- 'your-password'
OS_PASSWORD_HASH=

# Secret key used for signing session cookies (minimum 32 characters)
OS_SESSION_SECRET=

# Two-Factor Authentication (TOTP) base32 secret (optional, stored on server only)
OS_TOTP_SECRET=

# Alternative path to a file storing the TOTP secret (created with 0600 permissions)
OS_TOTP_SECRET_FILE=

# ------------------------------------------------------------------------------
# Server & Runtime
# ------------------------------------------------------------------------------
# HTTP port the Next.js server listens on (default: 3000)
PORT=3000

# Network interface to bind to (default: 0.0.0.0)
HOSTNAME=0.0.0.0

# Public URL of this instance without trailing slash (e.g. https://bmqos.example.com)
# Required when running behind reverse proxies / Cloudflare tunnel for HTTPS redirects & cookies
OS_ORIGIN=

# Demo mode: Demo/mock data is used automatically when backend integration
# credentials (HERMES_API_URL, CREW_API_URL, PAPERCLIP_API_URL) are not set.
# Supplying those credentials switches the panel to live mode.

# Enable execution of agent actions and live state mutations (1 = enabled, 0 = proposals only)
OS_CONTROL=0

# ------------------------------------------------------------------------------
# Database & Storage
# ------------------------------------------------------------------------------
# Path to SQLite database file (drafts, sessions, 2FA, audit log, chat history)
OS_DB=data/os.db

# Base directory for persistent data and audit logs (default: ./data)
OS_DATA_DIR=./data

# Directory containing project hub markdown files
OS_HUBS_DIR=

# Path or identifier for storing agent actions
OS_ACTIONS=

# Path or configuration for agent storage
OS_AGENTS=

# ------------------------------------------------------------------------------
# Assistant chat (Hermes Agent API server: https://github.com/NousResearch/hermes-agent)
# ------------------------------------------------------------------------------
# Base URL of the Hermes Agent API server, without a path (e.g. http://localhost:8642)
HERMES_API_URL=

# API key for the Hermes agent (if omitted or unreachable, chat runs in demo mode)
HERMES_API_KEY=

# Optional system prompt override for Hermes ({{STAV}} is replaced with current state)
HERMES_SYSTEM=

# ------------------------------------------------------------------------------
# Crew API
# ------------------------------------------------------------------------------
# Base URL for the Crew API service (e.g. http://localhost:3800)
CREW_API_URL=

# Authentication token for Crew API requests
CREW_API_TOKEN=

# ------------------------------------------------------------------------------
# Paperclip Integration
# ------------------------------------------------------------------------------
# Paperclip API endpoint (read-only by default; tokens are never sent to client)
PAPERCLIP_API_URL=

# Bearer token for authenticating with the Paperclip API
PAPERCLIP_API_TOKEN=

# Company UUID in Paperclip
PAPERCLIP_COMPANY_ID=

# Base URL to view issues in Paperclip web UI (without trailing slash; issue key is appended)
PAPERCLIP_ISSUE_URL=

# Allow writing responses back to Paperclip (1 = write enabled, 0 = saved locally in SQLite)
PAPERCLIP_WRITE=0

# ------------------------------------------------------------------------------
# Social Module Proxy
# ------------------------------------------------------------------------------
# URL of the social-manager backend service proxying /api/social/*
SOCIAL_API_URL=

# Bearer token for accessing drafts API (server-side only, never leaked to client)
DRAFTS_API_TOKEN=

# ------------------------------------------------------------------------------
# Card Webhooks & Security
# ------------------------------------------------------------------------------
# Shared key for authenticating incoming card webhook requests from LAN / agents
OS_CARDS_KEY=

# ------------------------------------------------------------------------------
# GitHub Integration
# ------------------------------------------------------------------------------
# GitHub fine-grained personal access token with read permissions (Contents, Pull requests, Metadata)
GITHUB_TOKEN=

# GitHub API base URL (default: https://api.github.com)
GITHUB_API_URL=https://api.github.com

# Comma-separated list of allowed repository slugs (e.g. owner/repo1,owner/repo2)
OS_ALLOWED_REPOS=

# Allow merging pull requests directly from BMQOS (1 = allow merge, 0 = record intention only)
GITHUB_MERGE=0

# Cache TTL in milliseconds for GitHub API responses (default: 60000)
GH_TTL_MS=60000

# Automated reviewer agent ID for merge checks
OS_JUDGE_AGENT_ID=

# ------------------------------------------------------------------------------
# Web Push Notifications
# ------------------------------------------------------------------------------
# Generate keys with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID public key for web push subscriptions
VAPID_PUBLIC=

# VAPID private key for sending push notifications
VAPID_PRIVATE=

# Contact URL or mailto: URI for the VAPID subject
VAPID_SUBJECT=

# ------------------------------------------------------------------------------
# Voice Input (Speech-to-Text)
# ------------------------------------------------------------------------------
# URL of local faster-whisper STT service (e.g. http://127.0.0.1:8765)
STT_URL=

# Anthropic API key for transcript cleanup using Claude Haiku (optional, raw text if empty)
ANTHROPIC_API_KEY=

# Optional Anthropic API base URL
ANTHROPIC_BASE_URL=

# Anthropic model for voice transcript cleanup (default: claude-3-5-haiku-20241022)
VOICE_MODEL=claude-3-5-haiku-20241022

# ------------------------------------------------------------------------------
# Infrastructure & Deployment Monitoring
# ------------------------------------------------------------------------------
# Dokploy API endpoint for deployment monitoring
DOKPLOY_URL=

# Dokploy API authentication token
DOKPLOY_TOKEN=

# Dokploy deployment target machine or identifier
OS_DOKPLOY_MACHINE=
OS_DOKPLOY_TARGET=

# Base preview host for dynamic environments
OS_PREVIEW_HOST=

# Proxmox VE API URL for cluster/node infrastructure metrics
PVE_API_URL=

# Proxmox VE target node name
PVE_NODE=

# Proxmox VE API token (format: USER@REALM!TOKENID=UUID)
PVE_TOKEN=

# Monitored server list (comma-separated or JSON)
OS_SERVERS=

# Static network map configuration (JSON)
OS_NETMAP_STATIC=

# Service status check cache TTL in milliseconds
OS_SVC_TTL_MS=60000

# Branch name to watch for CI/CD status
OS_TEST_BRANCH=

# Estimated LLM cost in USD per million tokens
OS_USD_PER_MTOK=

# ------------------------------------------------------------------------------
# Documentation Indexing
# ------------------------------------------------------------------------------
# Root directories allowed for documentation browsing and indexing
OS_DOC_ROOTS=

# Allow editing documentation files through the UI (1 = allow, 0 = read-only)
OS_DOCS_WRITE=0

# Track documentation issues (1 = enabled, 0 = disabled)
OS_DOCS_ISSUES=0

# ------------------------------------------------------------------------------
# Projects
# ------------------------------------------------------------------------------
# Your products as JSON: [{"n":"Shop","re":"shop|store","url":"https://shop.example.com"}]
# n = name, re = regex that matches task titles of this project, url = live site. Empty = demo projects.
OS_PROJECTS=
