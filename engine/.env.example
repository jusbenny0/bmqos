# ==============================================================================
# Crew Engine Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3800
CREW_URL=http://127.0.0.1:3800

# Authentication & Security
# Password for logging in to the web dashboard UI
CREW_PASSWORD=change-me-to-a-secure-password

# Secret key used for signing session cookies (falls back to CREW_PASSWORD if unset)
CREW_SESSION_SECRET=change-me-to-a-long-random-secret-key

# Bearer token for external API calls (Authorization: Bearer <CREW_API_TOKEN>)
# If left empty, Bearer authentication is disabled
CREW_API_TOKEN=generate-a-random-api-token-here

# Shared token for internal agent callbacks (passed in x-crew-token header)
CREW_TOKEN=generate-a-random-internal-token-here

# Agent Runtime Configuration
# Permission mode for Claude Code CLI executions
CREW_PERMISSION_MODE=bypassPermissions

# Maximum tool turns per execution run
CREW_MAX_TURNS=25

# Working directory for CEO planning agent (runs outside the codebase)
CREW_CEO_CWD=/tmp/crew-ceo

# Token Limits & Context Management
# Context window ceiling for Claude models
CREW_CONTEXT_WINDOW=200000

# Context window ceiling for Gemini models (agy)
CREW_AGY_CONTEXT_WINDOW=1000000

# Reset threshold for CEO session (drops context and re-reads DB digest to save tokens)
CREW_CEO_RESET_TOKENS=60000

# Default task token budget caps by size
CREW_CAP_S=300000
CREW_CAP_M=800000

# Self-improvement: agents end each task run with a RETRO line; a cheap model applies useful lessons
# to role prompts and brain/team/*.md (0 = off)
CREW_RETRO=1
CREW_RETRO_BATCH=5
CREW_RETRO_MODEL=haiku

# Reviewer evidence: build log, live `next start` preview and 1440/390 screenshots of changed pages (0 = off)
CREW_EVIDENCE=1
# CREW_EVIDENCE_PORT_BASE=4600
# CREW_CHROME=/path/to/chrome   (default: newest Playwright chromium in ~/.cache/ms-playwright)
