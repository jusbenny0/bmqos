{
  "manifest_version": "0.2",
  "name": "crew-engine",
  "display_name": "Crew Engine",
  "version": "1.1.0",
  "description": "Run your AI company from Claude Desktop: tasks, approvals, team, spend, evals, retros.",
  "author": { "name": "BMQOS" },
  "server": {
    "type": "node",
    "entry_point": "server.mjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server.mjs"],
      "env": { "CREW_URL": "${user_config.crew_url}", "CREW_API_TOKEN": "${user_config.crew_token}" }
    }
  },
  "user_config": {
    "crew_url": { "type": "string", "title": "Engine URL", "description": "e.g. http://192.168.1.10:3800", "required": true, "default": "http://localhost:3800" },
    "crew_token": { "type": "string", "title": "CREW_API_TOKEN", "sensitive": true, "required": true }
  }
}
