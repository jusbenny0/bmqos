#!/usr/bin/env node

/**
 * BMQOS CLI
 *
 * Usage:
 *   bmqos start [options]           Start Engine (+ Panel if found) and open browser
 *   bmqos install-launcher [path]   Install Linux .desktop launcher
 *   bmqos --help                    Display help
 */

import { spawn } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const rootDir = path.resolve(__dirname, '..');

const args = process.argv.slice(2);
const command = args[0] || 'start';

function printHelp() {
  console.log(`
BMQOS Command Line Tool

Usage:
  bmqos start [options]           Start Engine and Panel, and open web browser
  bmqos install-launcher [dest]   Install desktop shortcut for Linux
  bmqos --help                    Show this help message

Options for 'start':
  --no-browser                    Do not automatically open the browser
  --engine-only                   Run engine only, ignoring panel directory
  --help                          Show help for command

Environment variables:
  PORT                            Engine HTTP port (default: 3800)
  PANEL_PORT                      Panel HTTP port (default: 3000)
  BMQOS_PANEL_DIR                 Path to BMQOS panel directory
  NO_BROWSER                      Set to 1 to suppress opening browser
`);
}

if (args.includes('--help') || args.includes('-h') || command === 'help') {
  printHelp();
  process.exit(0);
}

switch (command) {
  case 'start': {
    const startScript = path.join(__dirname, 'start-all.mjs');
    const child = spawn(process.execPath, [startScript, ...args.slice(1)], {
      stdio: 'inherit'
    });
    child.on('exit', (code) => {
      process.exit(code ?? 0);
    });
    break;
  }

  case 'install-launcher': {
    const installScript = path.join(rootDir, 'launchers', 'install-desktop.sh');
    const child = spawn('bash', [installScript, ...args.slice(1)], {
      stdio: 'inherit'
    });
    child.on('exit', (code) => {
      process.exit(code ?? 0);
    });
    break;
  }

  default:
    console.error(`Unknown command: ${command}`);
    printHelp();
    process.exit(1);
}
