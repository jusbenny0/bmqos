{
  "name": "bmqos",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "OS_DEMO=0 OS_AUTH=password node --conditions react-server --import tsx --test tests/*.test.mts",
    "hash": "node scripts/hash.mjs",
    "setup": "node scripts/setup.mjs",
    "engine:install": "npm --prefix engine ci",
    "start:all": "node engine/scripts/start-all.mjs"
  },
  "dependencies": {
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "description": "BMQOS: a control panel for running a company with AI agents"
}
